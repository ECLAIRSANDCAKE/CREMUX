<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Storage" android:textColor="?attr/tx_text" android:textSize="13sp" />
        <TextView android:id="@+id/stat_storage_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/tx_text_2" android:textSize="12sp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/stat_storage_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="100" android:progressTint="?attr/tx_accent" android:progressBackgroundTint="?attr/tx_stroke" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Memory" android:textColor="?attr/tx_text" android:textSize="13sp" />
        <TextView android:id="@+id/stat_ram_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/tx_text_2" android:textSize="12sp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/stat_ram_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="100" android:progressTint="?attr/tx_accent" android:progressBackgroundTint="?attr/tx_stroke" />
    <TextView android:id="@+id/stat_extra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="?attr/tx_text_2" android:textSize="12sp" />
</LinearLayout>
