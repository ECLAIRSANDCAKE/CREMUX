<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tx_surface_2"/>
            <stroke android:width="1.5dp" android:color="?attr/tx_accent"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tx_surface"/>
            <stroke android:width="1dp" android:color="?attr/tx_stroke"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</selector>
